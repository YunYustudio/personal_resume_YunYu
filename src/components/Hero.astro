---
import { ui } from "../i18n/ui";
import { withBase } from "../utils";
---

<section class="hero band" id="top">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <p class="eyebrow" data-i18n="hero.eyebrow">{ui.zh["hero.eyebrow"]}</p>
      <h1 data-i18n="person.name">{ui.zh["person.name"]}</h1>
      <p class="hero-title" data-i18n="hero.title">{ui.zh["hero.title"]}</p>
      <p class="hero-lead" data-i18n="hero.lead">{ui.zh["hero.lead"]}</p>
      <div class="hero-actions" aria-label="主要操作" data-i18n-attr="aria-label:hero.actionsAria">
        <a class="button primary" href={withBase("/") + "#projects"} data-i18n="hero.ctaProjects">{ui.zh["hero.ctaProjects"]}</a>
        <a class="button secondary" href="https://gitee.com/yunyustudio" target="_blank" rel="noreferrer" data-i18n="hero.ctaGitee">{ui.zh["hero.ctaGitee"]}</a>
        <a class="button secondary" href="https://github.com/YunYustudio" target="_blank" rel="noreferrer" data-i18n="hero.ctaGithub">{ui.zh["hero.ctaGithub"]}</a>
        <a class="button ghost" href="mailto:tearhacker@outlook.com" data-i18n="hero.ctaEmail">{ui.zh["hero.ctaEmail"]}</a>
        <button class="wx-btn js-wx-open" type="button" data-i18n="contact.wechat">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M8.69 4C4.72 4 1.5 6.67 1.5 9.96c0 1.89 1.08 3.58 2.77 4.66l-.55 2.04 2.4-1.2c.86.24 1.78.42 2.57.42-.23-.6-.35-1.24-.35-1.9 0-3.3 3.22-5.97 7.18-5.97.13 0 .25 0 .37.02C15.47 5.32 12.34 4 8.69 4zm-2.5 3.3a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12zm4.99 0a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12zm5.82 2.78c-3.32 0-6.02 2.28-6.02 5.08 0 2.8 2.7 5.07 6.02 5.07.7 0 1.37-.08 2.02-.27l1.87.96-.52-1.62c1.35-.89 2.22-2.22 2.22-3.74 0-2.8-2.7-5.48-6.02-5.48zm-2.15 2.42a.86.86 0 1 1 0 1.72.86.86 0 0 1 0-1.72zm4.3 0a.86.86 0 1 1 0 1.72.86.86 0 0 1 0-1.72z"/>
          </svg>
          <span data-i18n="contact.wechat">{ui.zh["contact.wechat"]}</span>
        </button>
      </div>

      <div class="signal-row" aria-label="职业亮点" data-i18n-attr="aria-label:hero.signalsAria">
        <span data-i18n="hero.signal1">{ui.zh["hero.signal1"]}</span>
        <span data-i18n="hero.signal2">{ui.zh["hero.signal2"]}</span>
        <span data-i18n="hero.signal3">{ui.zh["hero.signal3"]}</span>
      </div>
    </div>

    <div class="hero-media reveal" aria-label="项目截图预览" data-i18n-attr="aria-label:hero.mediaAria">
      <div class="holo-ring" aria-hidden="true"></div>
      <figure class="desktop-shot">
        <img
          src={withBase("assets/images/ordering/ordering-12.webp")}
          width="1800"
          height="887"
          data-alt-zh="点餐系统老板视图数据看板"
          data-alt-en="Owner dashboard of the ordering system"
          alt="点餐系统老板视图数据看板"
        />
        <figcaption data-i18n="hero.desktopCaption">{ui.zh["hero.desktopCaption"]}</figcaption>
      </figure>
      <figure class="phone-shot phone-a">
        <img
          src={withBase("assets/images/forum/forum-07.webp")}
          width="810"
          height="1800"
          data-alt-zh="看雪校园论坛小程序帖子列表"
          data-alt-en="Post list page of the Kanxue Campus mini-program"
          alt="看雪校园论坛小程序帖子列表"
        />
      </figure>
      <figure class="phone-shot phone-b">
        <img
          src={withBase("assets/images/ordering/ordering-09.webp")}
          width="355"
          height="779"
          data-alt-zh="点餐小程序商品列表页面"
          data-alt-en="Product list page of the ordering mini-program"
          alt="点餐小程序商品列表页面"
        />
      </figure>
      <figure class="phone-shot phone-c">
        <img
          src={withBase("assets/images/fresh-mall/fresh-mall-mini-01.webp")}
          width="810"
          height="1800"
          data-alt-zh="生鲜商城小程序首页"
          data-alt-en="Fresh mall mini-program home"
          alt="生鲜商城小程序首页"
        />
      </figure>
      <figure class="phone-shot phone-d">
        <img
          src={withBase("assets/images/jx-forum/jx-forum-mini-01.webp")}
          width="810"
          height="1800"
          data-alt-zh="JX 蕴宇高校论坛小程序首页"
          data-alt-en="JX Campus Forum mini-program home"
          alt="JX 蕴宇高校论坛小程序首页"
        />
      </figure>
    </div>
  </div>
</section>
