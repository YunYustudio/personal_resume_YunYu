---
import { contact } from "../data/site";
import { ui } from "../i18n/ui";
import { withBase } from "../utils";
---

<section class="band" id="contact">
  <div class="container contact-panel reveal">
    <div>
      <p class="eyebrow" data-i18n="contact.eyebrow">{ui.zh["contact.eyebrow"]}</p>
      <h2 data-i18n="contact.title">{ui.zh["contact.title"]}</h2>
      <p data-i18n="contact.lead">{ui.zh["contact.lead"]}</p>
    </div>
    <div class="contact-actions">
      {contact.emails.map((e) => (
        <a class="button primary" href={e.href}>{e.label}</a>
      ))}
      <a class="button ghost" href={contact.gitee.href} target="_blank" rel="noreferrer">{contact.gitee.label}</a>
      <button class="wx-btn js-wx-open" type="button" data-i18n="contact.wechat">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8.69 4C4.72 4 1.5 6.67 1.5 9.96c0 1.89 1.08 3.58 2.77 4.66l-.55 2.04 2.4-1.2c.86.24 1.78.42 2.57.42-.23-.6-.35-1.24-.35-1.9 0-3.3 3.22-5.97 7.18-5.97.13 0 .25 0 .37.02C15.47 5.32 12.34 4 8.69 4zm-2.5 3.3a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12zm4.99 0a1.06 1.06 0 1 1 0 2.12 1.06 1.06 0 0 1 0-2.12zm5.82 2.78c-3.32 0-6.02 2.28-6.02 5.08 0 2.8 2.7 5.07 6.02 5.07.7 0 1.37-.08 2.02-.27l1.87.96-.52-1.62c1.35-.89 2.22-2.22 2.22-3.74 0-2.8-2.7-5.48-6.02-5.48zm-2.15 2.42a.86.86 0 1 1 0 1.72.86.86 0 0 1 0-1.72zm4.3 0a.86.86 0 1 1 0 1.72.86.86 0 0 1 0-1.72z"/>
        </svg>
        <span data-i18n="contact.wechat">{ui.zh["contact.wechat"]}</span>
      </button>
    </div>
  </div>
</section>

<!-- 微信二维码弹窗 -->
<div class="wx-modal" id="wx-modal" hidden>
  <div class="wx-modal-backdrop" id="wx-backdrop"></div>
  <div class="wx-modal-panel">
    <button class="wx-modal-close" id="wx-close-btn" type="button" aria-label="关闭" data-i18n-attr="aria-label:contact.wechatClose">&times;</button>
    <img src={withBase(contact.wechat.qrcode)} alt="微信二维码" id="wx-qr-img" />
    <div class="wx-modal-tip" id="wx-tip" data-i18n="contact.wechatTip">{ui.zh["contact.wechatTip"]}</div>
  </div>
</div>

<script>
  const modal = document.getElementById("wx-modal");
  const backdrop = document.getElementById("wx-backdrop");
  const closeBtn = document.getElementById("wx-close-btn");
  const openBtns = document.querySelectorAll(".js-wx-open");

  function openWx() { modal!.removeAttribute("hidden"); document.body.style.overflow = "hidden"; }
  function closeWx() { modal!.setAttribute("hidden", ""); document.body.style.overflow = ""; }

  openBtns.forEach((b) => b.addEventListener("click", openWx));
  backdrop?.addEventListener("click", closeWx);
  closeBtn?.addEventListener("click", closeWx);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal!.hasAttribute("hidden")) closeWx(); });
</script>
