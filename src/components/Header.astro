---
import { withBase } from "../utils";
import { ui } from "../i18n/ui";

const home = withBase("/"); // 首页地址（带 base 前缀），配合锚点可在任意页面跳转回首页对应区块
const navItems = [
  { href: home + "#proof", key: "nav.proof" },
  { href: home + "#projects", key: "nav.projects" },
  { href: home + "#gallery", key: "nav.gallery" },
  { href: withBase("resume"), key: "nav.resume" },
  { href: home + "#contact", key: "nav.contact" },
];
---

<header class="site-header">
  <a class="brand" href={withBase("")} aria-label="返回首页" data-i18n-attr="aria-label:nav.homeAria">
    <span class="brand-mark">YY</span>
    <span data-i18n="person.name">{ui.zh["person.name"]}</span>
  </a>
  <nav class="site-nav" aria-label="主导航" data-i18n-attr="aria-label:nav.aria">
    {navItems.map((item) => (
      <a href={item.href} data-i18n={item.key}>{ui.zh[item.key]}</a>
    ))}
  </nav>
  <div class="lang-switch" role="group" aria-label="Language switcher">
    <button class="lang-button is-active" type="button" data-lang="zh" aria-pressed="true">中</button>
    <button class="lang-button" type="button" data-lang="en" aria-pressed="false">EN</button>
  </div>
</header>
